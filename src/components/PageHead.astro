---
import Mark from './Mark.astro';
interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  crumbs: { name: string; href?: string }[];
}
const { title, lead, eyebrow, crumbs } = Astro.props;
---

<header class="phead">
  <Mark class="phead__mark" />
  <div class="container">
    <div class="phead__grid">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {
            crumbs.map((c, i) => (
              <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
            ))
          }
        </ol>
      </nav>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="h1" style="font-size:clamp(2.25rem,6vw,4.75rem)">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</header>
