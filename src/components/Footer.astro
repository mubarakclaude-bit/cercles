---
// A quiet footer in the Apple manner: small type, light grey, columns that fold away on phones.
import Logo from './Logo.astro';
import { SITE, SERVICES, LANDINGS, waLink } from '../data/site';
const year = new Date().getFullYear();
const addr = SITE.address;
const cols = [
  { title: 'Services', links: SERVICES.map((s) => ({ href: `/services/${s.slug}/`, label: s.label })) },
  { title: 'Popular in Kozhikode', links: LANDINGS.map((l) => ({ href: `/kozhikode/${l.slug}/`, label: l.label })) },
  {
    title: 'Cercles',
    links: [
      { href: '/services/', label: 'All services' },
      { href: '/full-circle-projects/', label: 'Full-Circle Projects' },
      { href: '/guides/', label: 'Guides' },
      { href: '/about/', label: 'About' },
      { href: '/contact/', label: 'Contact' },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <p class="footer__note">
      Cercles is a one-stop home solutions company in Kozhikode (Calicut), Kerala. Interiors, curtains, electrical, plumbing, roofing, facades and gardens, from one accountable team. Free site visits across Kozhikode.
    </p>
    <div class="footer__cols">
      {
        cols.map((c) => (
          <details class="footer__col" open>
            <summary class="footer__h">{c.title}</summary>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
      <details class="footer__col" open>
        <summary class="footer__h">Contact</summary>
        <ul>
          <li><a href={`tel:${SITE.phoneRaw}`}>{SITE.phone}</a></li>
          <li><a href={waLink('Hi Cercles, I would like a quotation.')} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.instagram} target="_blank" rel="noopener me">Instagram</a></li>
          <li class="footer__addr">
            {addr ? <>{addr.street}, {addr.locality}, {addr.region} {addr.postalCode}</> : <>Kozhikode, Kerala, India</>}
          </li>
        </ul>
      </details>
    </div>
    <div class="footer__bar">
      <a class="logo footer__logo" href="/" aria-label="Cercles, home"><Logo /></a>
      <span>Copyright &copy; {year} Cercles. All rights reserved.</span>
      <nav class="footer__legal" aria-label="Legal">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/sitemap-index.xml">Site Map</a>
      </nav>
    </div>
  </div>
</footer>
