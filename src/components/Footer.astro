---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, SERVICES, AREAS } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__about">
        <a class="logo" href="/" aria-label="Cercles, home"><Logo /></a>
        <p>{SITE.description}</p>
        <p>
          <a href={`tel:${SITE.phoneRaw}`}>{SITE.phone}</a><br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
        <p>
          <a href={SITE.instagram} rel="noopener me" target="_blank" aria-label="Cercles on Instagram"
            ><span style="display:inline-flex;gap:8px;align-items:center"><span style="width:22px;height:22px;display:inline-block"><Icon name="instagram" /></span> @cercles.in</span></a
          >
        </p>
      </div>
      <div>
        <p class="footer__h">Services</p>
        <ul>
          {SERVICES.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="footer__h">Areas we serve</p>
        <ul>
          {AREAS.map((a) => <li><a href={`/areas/${a.slug}/`}>{a.name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="footer__h">Cercles</p>
        <ul>
          <li><a href="/full-circle-projects/">Full-Circle Projects</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__word" aria-hidden="true">cercles</div>
    <div class="footer__bar">
      <span>&copy; {year} Cercles. All rights reserved.</span>
      <span>Roof to Garden. One Call.</span>
    </div>
  </div>
</footer>
