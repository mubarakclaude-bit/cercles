---
// Longer reading content: a heading, a few paragraphs and an optional list per section.
import { anchor } from '../lib/anchor';
import Art from './Art.astro';
import { hasPic } from '../data/curtainTypes';
// Used by guides and by the curtain pages, where depth is what ranks.
import type { Section } from '../data/curtains';
interface Props {
  items: Section[];
  id?: string;
  /** styles available in this page's 3D box: those cards open it */
  tryable?: string[];
}
const { items, id, tryable = [] } = Astro.props;
---

<div class="read" id={id}>
  {
    items.map((s) => (
      <section class="read__sec" id={anchor(s.h)}>
        <h2 class="h3">{s.h}</h2>
        {s.p?.map((t) => <p set:html={t} />)}
        {s.list && <ul class="read__list">{s.list.map((t) => <li set:html={t} />)}</ul>}
        {s.cards && (
          <div class="looks">
            {s.cards.map((c) => {
              const tries = !c.href && tryable.includes(c.art);
              const Tag = c.href ? 'a' : tries ? 'button' : 'div';
              const photo = hasPic(c.art);
              return (
                <Tag class="look" href={c.href} type={tries ? 'button' : undefined} data-try={tries ? c.art : undefined}>
                  <div class:list={['look__pic', { 'look__pic--photo': photo }]}>
                    {photo ? <img src={`/curtains/${c.art}-s.webp`} alt={`${c.t} in a room`} width="480" height="360" loading="lazy" decoding="async" /> : <Art name={c.art} />}
                  </div>
                  <h3>{c.t}</h3>
                  <p>{c.d}</p>
                  {tries && <span class="look__try">Try it in 3D ↑</span>}
                </Tag>
              );
            })}
          </div>
        )}
        {s.figure && (
          <figure class:list={['fig', { 'fig--small': s.figure.small }]}>
            <Art name={s.figure.art} label={s.figure.caption} />
            <figcaption>{s.figure.caption}</figcaption>
          </figure>
        )}
        {s.after?.map((t) => <p set:html={t} />)}
      </section>
    ))
  }
</div>
