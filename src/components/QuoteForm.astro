---
import { SERVICES, SITE } from '../data/site';
interface Props {
  service?: string;
}
const { service = '' } = Astro.props;
---

<form class="form" data-quote data-key={SITE.web3formsKey} data-whatsapp={SITE.whatsapp} novalidate>
  <div class="form__row">
    <div class="field">
      <label for="q-name">Your name</label>
      <input id="q-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="q-phone">Phone number</label>
      <input id="q-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
    </div>
  </div>
  <div class="form__row">
    <div class="field">
      <label for="q-service">What do you need?</label>
      <select id="q-service" name="service" required>
        <option value="">Choose a service</option>
        <option value="Complete Full-Circle project">Complete Full-Circle project</option>
        {SERVICES.map((s) => <option value={s.name} selected={s.slug === service}>{s.name}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="q-area">Town or district</label>
      <input id="q-area" name="area" type="text" autocomplete="address-level2" />
    </div>
  </div>
  <div class="field">
    <label for="q-details">Tell us a little about it <span class="hint">(optional)</span></label>
    <textarea id="q-details" name="details" rows="4"></textarea>
  </div>
  <!-- Spam trap: people never see or tick this. -->
  <input type="checkbox" name="botcheck" class="form__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="btn-row">
    <button class="btn" type="submit" data-send>Send enquiry</button>
    <button class="btn btn--line" type="button" data-wa>Send on WhatsApp</button>
  </div>
  <p class="form__status" role="status" aria-live="polite" hidden></p>
  <p class="hint">We reply within one working day, usually by phone. Prefer to talk now? Call <a href={`tel:${SITE.phoneRaw}`}>{SITE.phone}</a>.</p>
</form>
