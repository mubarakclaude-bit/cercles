---
// A calm first view built on the brand's circles: rings that turn slowly, small orbiting points,
// the Cercles mark at the centre. No 3D, so it loads instantly and feels different from the home tour.
import Mark from './Mark.astro';
import Art from './Art.astro';
import { hasPic } from '../data/curtainTypes';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs: { name: string; href?: string }[];
  compact?: boolean;
  art?: string; // a line drawing in the centre instead of the mark
}
const { eyebrow, title, lead, crumbs, compact = false, art } = Astro.props;
---

<section class:list={['rhero', { 'rhero--compact': compact }]}>
  <div class="container rhero__grid">
    <div class="rhero__copy">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {crumbs.map((c, i) => <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
        </ol>
      </nav>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="h1">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    <div class="rhero__art" aria-hidden="true">
      <svg viewBox="0 0 400 400" fill="none">
        <circle class="rr rr--a" cx="200" cy="200" r="188" />
        <circle class="rr rr--b" cx="200" cy="200" r="150" />
        <circle class="rr rr--c" cx="200" cy="200" r="112" />
        <g class="orb orb--1"><circle cx="200" cy="50" r="7" /></g>
        <g class="orb orb--2"><circle cx="200" cy="88" r="5" /></g>
        <g class="orb orb--3"><circle cx="200" cy="12" r="4" /></g>
        <circle cx="200" cy="200" r="72" class="rr-core" />
      </svg>
      {art ? (hasPic(art) ? <div class="rhero__pic rhero__pic--photo"><img src={`/curtains/${art}.webp`} alt="" width="800" height="600" fetchpriority="high" /></div> : <div class="rhero__pic"><Art name={art} /></div>) : <Mark class="rhero__mark" />}
    </div>
  </div>
</section>
