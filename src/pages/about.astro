---
import Base from '../layouts/Base.astro';
import PartHero from '../components/PartHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const values = [
  ['Craftsmanship', 'Every finish is built to last and made to look good.'],
  ['Transparency', 'Clear quotations, no surprises.'],
  ['Reliability', 'Work delivered on schedule, as promised.'],
  ['Accountability', 'One team that owns the result from start to finish.'],
  ['Smart living', 'Automation built into curtains, lighting and irrigation.'],
];
const serve = [
  'Homeowners renovating or upgrading',
  'New villa and apartment owners who need a complete fit-out',
  'Landlords and property investors',
  'Small commercial spaces such as shops and offices',
];
---

<Base
  title="About Cercles: Home Solutions in Kozhikode"
  description="Cercles is a one-stop home solutions company in Kozhikode (Calicut), Kerala. One team, one plan and one point of contact from roof to garden."
  path="/about/"
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }])]}
>
  <PartHero
    slug="painting-texturing"
    eyebrow="About Cercles"
    title="Complete the circle of your home."
    lead="A home is never finished in one place. The curtains need a painter, the painter needs an electrician, and somewhere in the middle, you are the one chasing everyone. Cercles, from Kozhikode, closes the circle."
    crumbs={[{ name: 'About' }]}
  />


  <section class="section" id="details">
    <div class="container split">
      <div class="prose reveal">
        <h2 class="h2" style="margin-bottom:20px">What we do</h2>
        <p class="lead" style="max-width:none">
          Cercles is a one-stop home solutions company based in Kozhikode (Calicut). We design, build and finish every part of a home, inside and out, and deliver it either as a complete project or as a single service. One quotation. One schedule. One standard of quality.
        </p>
        <p class="muted">
          Our service brand is <strong>{SITE.brand}</strong>: a complete, end-to-end home transformation service covering interiors, exteriors, utilities and outdoors, delivered by one accountable team.
        </p>
        <h2 class="h3" style="margin:40px 0 10px">Vision</h2>
        <p class="muted">To be the most trusted name in home improvement, where every home is complete, comfortable and cared for.</p>
        <h2 class="h3" style="margin:32px 0 10px">Mission</h2>
        <p class="muted">To give every homeowner one reliable partner for every part of their home, with quality craftsmanship, clear pricing and smart, modern solutions.</p>
      </div>
      <aside class="sticky">
        <div class="panel reveal">
          <h2 class="h3">Who we serve</h2>
          <ul class="checklist">{serve.map((s) => <li>{s}</li>)}</ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tile">
    <div class="container">
      <div class="section-head reveal"><p class="eyebrow">Core values</p><h2 class="h2">What we stand for.</h2></div>
      <div class="grid grid--3">
        {values.map(([t, d], i) => (
          <div class="card reveal" style={`--d:${i % 3}`}>
            <h3 class="h3">{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta on-dark reveal">
        <h2 class="h2">One call to start your project.</h2>
        <div class="btn-row">
          <a class="btn btn--lime" href="/contact/">Get a free quote <Icon name="arrow" /></a>
          <a class="btn btn--line" href="/services/">Explore services</a>
        </div>
      </div>
    </div>
  </section>
</Base>
