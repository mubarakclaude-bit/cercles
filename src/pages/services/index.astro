---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ServiceOrbit from '../../components/ServiceOrbit.astro';
import { CATEGORIES, servicesIn, SERVICES, SEO } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';

const itemList = {
  '@type': 'ItemList',
  name: 'Cercles services in Kozhikode',
  itemListElement: SERVICES.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://cercles.in/services/${s.slug}/`,
    name: SEO[s.slug]?.h1 ?? s.name,
  })),
};
---

<Base
  title="Home Improvement Services in Kozhikode"
  description="All 13 Cercles services in Kozhikode (Calicut): curtains, sofas, interiors, furniture, painting, electrical, plumbing, roofing, facades and gardens."
  path="/services/"
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]), itemList]}
>
  <section class="shub">
    <div class="container shub__grid">
      <div class="shub__copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol><li><a href="/">Home</a></li><li><span aria-current="page">Services</span></li></ol>
        </nav>
        <p class="eyebrow">Services in Kozhikode</p>
        <h1 class="h1">Every part of your home. One team.</h1>
        <p class="lead">Thirteen services from the roof to the garden. Book any one on its own, or plan them together as one project.</p>
        <ul class="chips">
          {CATEGORIES.map((c) => <li><a class="chip" href={`#cat-${c.id}`}>{c.short}</a></li>)}
        </ul>
      </div>
      <ServiceOrbit />
    </div>
  </section>

  <section class="section" style="padding-top:clamp(40px,5vw,72px)">
    <div class="container">
      {CATEGORIES.map((c) => (
        <div class="cat" id={`cat-${c.id}`}>
          <div class="cat__head reveal">
            <h2 class="h3">{c.name}</h2>
            <p>{c.blurb}</p>
          </div>
          <div class="grid grid--3">
            {servicesIn(c.id).map((s, i) => (
              <a class="card reveal" style={`--d:${i % 3}`} href={`/services/${s.slug}/`}>
                <span class="card__icon"><Icon name={s.icon} /></span>
                <h3 class="h3">{s.name}</h3>
                <p>{s.summary}</p>
                <span class="card__more">Learn more <Icon name="arrow" /></span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
