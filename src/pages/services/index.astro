---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Mark from '../../components/Mark.astro';
import { CATEGORIES, servicesIn, SERVICES, SEO } from '../../data/site';
import { POP } from '../../scene/director';
import { breadcrumbSchema } from '../../lib/schema';

const itemList = {
  '@type': 'ItemList',
  name: 'Cercles services in Kozhikode',
  itemListElement: SERVICES.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://cercles.in/services/${s.slug}/`,
    name: SEO[s.slug]?.h1 ?? s.name,
  })),
};
---

<Base
  title="Home Improvement Services in Kozhikode"
  description="All 13 Cercles services in Kozhikode (Calicut): curtains, sofas, interiors, furniture, painting, electrical, plumbing, roofing, facades and gardens."
  path="/services/"
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]), itemList]}
>
  <section class="explore">
    <div class="explore__view" aria-hidden="true">
      <div class="explore__sticky" data-explore>
        <Mark class="mark" />
        <canvas></canvas>
      </div>
    </div>
    <div class="explore__list">
      <header class="explore__head">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol><li><a href="/">Home</a></li><li><span aria-current="page">Services</span></li></ol>
        </nav>
        <p class="eyebrow">Services in Kozhikode</p>
        <h1 class="h1">Every part of your home. One team.</h1>
        <p class="lead">Thirteen services from the roof to the garden. Book any one on its own, or plan them together as one project.</p>
      </header>
      {
        CATEGORIES.map((c) => (
          <div class="explore__group">
            <h2 class="explore__cat">{c.name}</h2>
            <ul>
              {servicesIn(c.id).map((s) => (
                <li>
                  <a class="explore__item" href={`/services/${s.slug}/`} data-slug={s.slug} style={`--pop:${POP[s.slug]}`}>
                    <span class="explore__dot" aria-hidden="true" />
                    <span class="explore__text">
                      <strong>{s.name}</strong>
                      <span>{s.summary}</span>
                    </span>
                    <Icon name="arrow" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>
