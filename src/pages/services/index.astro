---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES, servicesIn, SERVICES } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';

const itemList = {
  '@type': 'ItemList',
  name: 'Cercles services',
  itemListElement: SERVICES.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://cercles.in/services/${s.slug}/`,
    name: s.name,
  })),
};
---

<Base
  title="Home Improvement Services in Kerala"
  description="All 13 Cercles services: curtains, sofas, interiors, furniture, painting, electrical, plumbing, roofing, facades, aluminium, landscaping, irrigation."
  path="/services/"
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]), itemList]}
>
  <PageHead
    title="13 services. One team."
    eyebrow="Services"
    lead="From the roof to the garden, every service can be booked on its own or combined into one complete Full-Circle project."
    crumbs={[{ name: 'Services' }]}
  />
  <section class="section">
    <div class="container">
      {CATEGORIES.map((c) => (
        <div class="cat">
          <div class="cat__head reveal">
            <h2 class="h3">{c.name}</h2>
            <p>{c.blurb}</p>
          </div>
          <div class="grid grid--3">
            {servicesIn(c.id).map((s, i) => (
              <a class="card reveal" style={`--d:${i % 3}`} href={`/services/${s.slug}/`}>
                <span class="card__icon"><Icon name={s.icon} /></span>
                <h3 class="h3">{s.name}</h3>
                <p>{s.summary}</p>
                <span class="card__more">Learn more <Icon name="arrow" /></span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
