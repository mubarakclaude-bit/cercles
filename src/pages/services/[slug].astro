---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Mark from '../../components/Mark.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Faq from '../../components/Faq.astro';
import { SERVICES, SERVICE_BY_SLUG, CATEGORIES, SITE } from '../../data/site';
import { POP } from '../../scene/director';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const cat = CATEGORIES.find((c) => c.id === s.category)!;
const related = s.related.map((r) => SERVICE_BY_SLUG[r]).filter(Boolean);
const path = `/services/${s.slug}/`;
---

<Base
  title={`${s.name} in Kerala`}
  description={s.description}
  path={path}
  schema={[
    serviceSchema(s),
    faqSchema(s.faqs),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/services/' },
      { name: s.name, path },
    ]),
  ]}
>
  <section class="shero" style={`--pop:${POP[s.slug]}`}>
    <div class="shero__view" data-part={s.slug} aria-hidden="true">
      <Mark class="mark" />
      <canvas></canvas>
      <div class="shero__fade"></div>
    </div>
    <div class="container shero__inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/services/">Services</a></li>
          <li><span aria-current="page">{s.name}</span></li>
        </ol>
      </nav>
      <div class="shero__body">
        <div class="shero__copy">
          <p class="eyebrow">{cat.name}</p>
          <h1>{s.title}</h1>
          <p class="lead">{s.intro}</p>
          <ul class="shero__facts">
            {s.idealFor.map((i) => <li>{i}</li>)}
          </ul>
          <div class="btn-row">
            <a class="btn" href="#quote">Get a free quote <Icon name="arrow" /></a>
            <a class="btn btn--line" href={`tel:${SITE.phoneRaw}`}>Call {SITE.phone}</a>
          </div>
        </div>
      </div>
      <a class="shero__more" href="#details" style="align-self:flex-start;text-decoration:none">Details <Icon name="arrow" /></a>
    </div>
  </section>

  <section class="section" id="details">
    <div class="container split">
      <div style="display:grid;gap:clamp(40px,5vw,64px)">
        <div class="reveal">
          <h2 class="h2" style="margin-bottom:24px">What is included</h2>
          <ul class="checklist">
            {s.includes.map((i) => <li>{i}</li>)}
          </ul>
        </div>
        <div class="note reveal">
          <p class="eyebrow" style="color:var(--lime)">Built for Kerala</p>
          <p>{s.keralaNote}</p>
        </div>
      </div>
      <aside class="sticky">
        <div class="panel reveal" id="quote" style="background:var(--tile)">
          <h2 class="h3">Get a free quote</h2>
          <QuoteForm service={s.slug} />
        </div>
      </aside>
    </div>
  </section>

  <Faq items={s.faqs} title={`${s.name}: your questions`} />

  <section class="section section--tile">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Often combined with</p>
        <h2 class="h2">Finish the whole circle.</h2>
        <p class="lead">Every service can be booked on its own, or planned together under one quotation and one schedule.</p>
      </div>
      <div class="grid grid--3">
        {related.map((r, i) => (
          <a class="card reveal" style={`--d:${i}`} href={`/services/${r.slug}/`}>
            <span class="card__icon"><Icon name={r.icon} /></span>
            <h3 class="h3">{r.name}</h3>
            <p>{r.summary}</p>
            <span class="card__more">Learn more <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
