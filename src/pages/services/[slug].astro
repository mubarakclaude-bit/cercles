---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PartHero from '../../components/PartHero.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Faq from '../../components/Faq.astro';
import { SERVICES, SERVICE_BY_SLUG, CATEGORIES, SITE, SEO, LANDINGS } from '../../data/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const seo = SEO[s.slug];
const cat = CATEGORIES.find((c) => c.id === s.category)!;
const related = s.related.map((r) => SERVICE_BY_SLUG[r]).filter(Boolean);
const local = LANDINGS.filter((l) => l.related.includes(s.slug));
const path = `/services/${s.slug}/`;
---

<Base
  title={seo.title}
  description={seo.description}
  path={path}
  schema={[
    serviceSchema(s),
    faqSchema(s.faqs),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/services/' },
      { name: s.name, path },
    ]),
  ]}
>
  <PartHero slug={s.slug} eyebrow={cat.name} title={seo.h1} lead={s.intro} facts={s.idealFor} crumbs={[{ name: 'Services', href: '/services/' }, { name: s.name }]}>
    <div class="btn-row">
      <a class="btn" href="#quote">Get a free quote <Icon name="arrow" /></a>
      <a class="btn btn--line" href={`tel:${SITE.phoneRaw}`}>Call {SITE.phone}</a>
    </div>
  </PartHero>

  <section class="section" id="details">
    <div class="container split">
      <div style="display:grid;gap:clamp(40px,5vw,64px)">
        <div class="reveal">
          <p class="eyebrow" style="margin-bottom:12px">{s.name} in Kozhikode</p>
          <h2 class="h2" style="margin-bottom:24px">What is included</h2>
          <ul class="checklist">
            {s.includes.map((i) => <li>{i}</li>)}
          </ul>
        </div>
        <div class="note reveal">
          <p class="eyebrow">Built for Kerala weather</p>
          <p>{s.keralaNote}</p>
        </div>
        {
          local.length > 0 && (
            <div class="reveal">
              <p class="eyebrow" style="margin-bottom:12px">Popular in Kozhikode</p>
              <div class="chips">
                {local.map((l) => (
                  <a class="chip" href={`/kozhikode/${l.slug}/`}>{l.label}</a>
                ))}
              </div>
            </div>
          )
        }
      </div>
      <aside class="sticky">
        <div class="panel reveal" id="quote">
          <h2 class="h3">Get a free quote</h2>
          <p class="muted" style="font-size:0.9375rem">Free site visit anywhere in Kozhikode.</p>
          <QuoteForm service={s.slug} />
        </div>
      </aside>
    </div>
  </section>

  <Faq items={s.faqs} title={`${s.name}: your questions`} />

  <section class="section section--tile">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Often combined with</p>
        <h2 class="h2">Finish the whole circle.</h2>
        <p class="lead">Every service can be booked on its own, or planned together under one quotation and one schedule.</p>
      </div>
      <div class="grid grid--3">
        {related.map((r, i) => (
          <a class="card reveal" style={`--d:${i}`} href={`/services/${r.slug}/`}>
            <span class="card__icon"><Icon name={r.icon} /></span>
            <h3 class="h3">{r.name}</h3>
            <p>{r.summary}</p>
            <span class="card__more">Learn more <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
