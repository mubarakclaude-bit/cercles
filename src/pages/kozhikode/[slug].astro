---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import RingHero from '../../components/RingHero.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Faq from '../../components/Faq.astro';
import HowWeWork from '../../components/HowWeWork.astro';
import Sections from '../../components/Sections.astro';
import CurtainLab from '../../components/CurtainLab.astro';
import { GUIDES } from '../../data/guides';
import { LANDINGS, SERVICE_BY_SLUG, SITE } from '../../data/site';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return LANDINGS.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props;
const path = `/kozhikode/${l.slug}/`;
const related = l.related.map((r) => SERVICE_BY_SLUG[r]).filter(Boolean);
const siblings = LANDINGS.filter((x) => x.slug !== l.slug && x.related[0] === l.related[0]);
const guides = GUIDES.filter((g) => g.service === l.related[0]);
const serviceNode = {
  '@type': 'Service',
  '@id': `https://cercles.in${path}#service`,
  name: l.h1,
  serviceType: l.label,
  description: l.description,
  url: `https://cercles.in${path}`,
  provider: { '@id': 'https://cercles.in/#organization' },
  areaServed: { '@type': 'City', name: 'Kozhikode', alternateName: 'Calicut' },
};
---

<Base
  title={l.title}
  description={l.description}
  path={path}
  schema={[serviceNode, faqSchema(l.faqs), breadcrumbSchema([{ name: 'Home', path: '/' }, { name: l.label, path }])]}
>
  <RingHero eyebrow="In Kozhikode" art={l.art} title={l.h1} lead={l.intro} crumbs={[{ name: l.label }]}>
    <div class="btn-row">
      <a class="btn" href="#quote">Get a free quote <Icon name="arrow" /></a>
      <a class="btn btn--line" href={`tel:${SITE.phoneRaw}`}>Call {SITE.phone}</a>
    </div>
  </RingHero>

  <section class="section" id="details">
    <div class="container split">
      <div style="display:grid;gap:clamp(40px,5vw,64px)">
        <div class="reveal">
          <h2 class="h2" style="margin-bottom:24px">What we do</h2>
          <ul class="checklist">{l.offer.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="note reveal">
          <p class="eyebrow">Why it matters in Kozhikode</p>
          <p>{l.local}</p>
        </div>
        {
          siblings.length > 0 && (
            <div class="reveal">
              <p class="eyebrow" style="margin-bottom:12px">Also in Kozhikode</p>
              <div class="chips">
                <a class="chip" href={`/services/${l.related[0]}/`}>{SERVICE_BY_SLUG[l.related[0]].name}</a>
                {siblings.map((x) => (
                  <a class="chip" href={`/kozhikode/${x.slug}/`}>{x.label}</a>
                ))}
              </div>
            </div>
          )
        }
      </div>
      <aside class="sticky">
        <div class="panel reveal" id="quote">
          <h2 class="h3">Get a free quote</h2>
          <p class="muted" style="font-size:0.9375rem">Free site visit anywhere in Kozhikode.</p>
          <QuoteForm service={l.related[0]} />
        </div>
      </aside>
    </div>
  </section>

  {
    (l.sections || l.lab || guides.length > 0) && (
      <section class="section" style="padding-top:0">
        <div class="container" style="display:grid;gap:clamp(32px,4vw,48px)">
          {l.lab && <CurtainLab types={l.lab} />}
          {l.sections && <Sections items={l.sections} tryable={l.lab} />}
          {guides.map((g) => (
            <a class="card reveal" style="max-width:44rem" href={`/guides/${g.slug}/`}>
              <p class="eyebrow">Guide</p>
              <h3 class="h3">{g.h1}</h3>
              <p>{g.description}</p>
              <span class="card__more">Read the guide <Icon name="arrow" /></span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <HowWeWork />
  <Faq items={l.faqs} title="Your questions, answered." />

  <section class="section section--tile">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Related services</p>
        <h2 class="h2">Done together, by one team.</h2>
      </div>
      <div class="grid grid--2">
        {related.map((r, i) => (
          <a class="card reveal" style={`--d:${i % 2}`} href={`/services/${r.slug}/`}>
            <span class="card__icon"><Icon name={r.icon} /></span>
            <h3 class="h3">{r.name}</h3>
            <p>{r.summary}</p>
            <span class="card__more">Learn more <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
