---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Journey from '../components/Journey.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Faq from '../components/Faq.astro';
import { SITE, HOME_FAQS } from '../data/site';
import { faqSchema } from '../lib/schema';


const compare = [
  ['Many contractors, many quotes', 'One team, one quotation'],
  ['Delays from poor coordination', 'One schedule, managed end to end'],
  ['Different quality standards', 'One consistent standard'],
  ['Nobody takes responsibility', 'One point of accountability'],
  ['Manual, outdated systems', 'Smart options: automated curtains, lighting and irrigation'],
];
---

<Base
  title="Cercles | One-Stop Home Solutions in Kerala"
  description="Interiors, curtains, electrical, plumbing, roofing, facades, landscaping and irrigation from one accountable team across Kerala. Roof to Garden. One Call."
  path="/"
  schema={[faqSchema(HOME_FAQS)]}
>
  <Journey />

  <!-- ============ WHY ============ -->
  <section class="section section--tile" aria-labelledby="why-title">
    <div class="container split split--even">
      <div class="sticky reveal">
        <div class="section-head" style="margin-bottom:28px">
          <p class="eyebrow">Why Cercles</p>
          <h2 class="h2" id="why-title">Stop chasing. Start finishing.</h2>
          <p class="lead">Home projects go wrong in the gaps between trades. Cercles takes the gaps away with one team that owns the result from start to finish.</p>
        </div>
        <a class="btn btn--text" href="/about/">About Cercles <Icon name="arrow" /></a>
      </div>
      <div class="compare">
        {compare.map(([bad, good], i) => (
          <div class="compare__row reveal" style={`--d:${i}`}>
            <span class="compare__bad">{bad}</span>
            <span class="compare__good">{good}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <HowWeWork />

  <!-- ============ TWO WAYS ============ -->
  <section class="section section--tile" aria-labelledby="ways-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Two ways to work with us</p>
        <h2 class="h2" id="ways-title">Big projects and small needs, treated the same.</h2>
      </div>
      <div class="ways">
        <div class="way way--full on-dark reveal">
          <p class="eyebrow">Full-Circle Project</p>
          <h3 class="h2" style="font-size:clamp(1.5rem,2.4vw,2rem)">One plan across every trade.</h3>
          <ul>
            <li>Best for renovations, new homes and complete fit-outs</li>
            <li>Any combination of our 13 services under one plan</li>
            <li>One combined quotation</li>
            <li>One schedule and one point of contact across all trades</li>
          </ul>
          <div class="btn-row"><a class="btn btn--lime" href="/full-circle-projects/">See Full-Circle Projects <Icon name="arrow" /></a></div>
        </div>
        <div class="way reveal" style="--d:1;background:#fff">
          <p class="eyebrow">Single Service</p>
          <h3 class="h2" style="font-size:clamp(1.5rem,2.4vw,2rem)">One room, one repair, one upgrade.</h3>
          <ul>
            <li>Any one service, booked on its own</li>
            <li>One focused quotation</li>
            <li>The same craftsmanship and standards as larger projects</li>
          </ul>
          <div class="btn-row"><a class="btn" href="/services/">Browse services <Icon name="arrow" /></a></div>
        </div>
      </div>
    </div>
  </section>

  <Faq items={HOME_FAQS} />

  <!-- ============ CTA ============ -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="cta on-dark reveal">
        <p class="eyebrow">Ready when you are</p>
        <h2 class="h2">Complete the circle of your home.</h2>
        <p class="lead">One call to start. One plan for every trade. One finish you are proud of.</p>
        <div class="btn-row">
          <a class="btn btn--lime" href="/contact/">Get a free quote <Icon name="arrow" /></a>
          <a class="btn btn--line" href={`tel:${SITE.phoneRaw}`}>Call {SITE.phone}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
