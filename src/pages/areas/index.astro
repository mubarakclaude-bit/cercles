---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { AREAS } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';

const groups = [
  { title: 'Home base', items: AREAS.filter((a) => a.tier === 'home') },
  { title: 'Across Kerala', items: AREAS.filter((a) => a.tier === 'kerala') },
  { title: 'Beyond Kerala', items: AREAS.filter((a) => a.tier === 'nearby-state') },
];
---

<Base
  title="Areas We Serve: Kerala, Coimbatore & Bangalore"
  description="Cercles is based in Kozhikode and serves Malappuram, Kannur, Wayanad, Palakkad, Thrissur, Kochi, Coimbatore and Bangalore."
  path="/areas/"
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Areas', path: '/areas/' }])]}
>
  <PageHead
    title="Based in Kozhikode. Working across the region."
    eyebrow="Areas we serve"
    lead="One team for the whole job, wherever the site is. Choose your area to see what we do there."
    crumbs={[{ name: 'Areas' }]}
  />
  <section class="section">
    <div class="container">
      {groups.map((g) => (
        <div class="cat">
          <div class="cat__head reveal"><h2 class="h2" style="font-size:clamp(1.5rem,3vw,2.25rem)">{g.title}</h2></div>
          <div class="grid grid--3">
            {g.items.map((a, i) => (
              <a class="card reveal" style={`--d:${i % 3}`} href={`/areas/${a.slug}/`}>
                <h3 class="h3">{a.name}</h3>
                <p>{a.places.slice(0, 5).join(', ')} and more.</p>
                <span class="card__more">See services here <Icon name="arrow" /></span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
