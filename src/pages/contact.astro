---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { SITE, waLink } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const contactPage = {
  '@type': 'ContactPage',
  url: 'https://cercles.in/contact/',
  name: 'Contact Cercles',
  about: { '@id': 'https://cercles.in/#organization' },
};
---

<Base
  title="Contact Cercles: Free Quote in Kozhikode & Kerala"
  description="Call or WhatsApp +91 75599 42708 for a free site visit and quotation. Cercles serves Kozhikode, Kerala, Coimbatore and Bangalore."
  path="/contact/"
  noFab
  schema={[contactPage, breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }])]}
>
  <PageHead
    title="Let's plan your project."
    eyebrow="Contact"
    lead="Tell us what you need. We will visit the site, understand the space and send one clear quotation."
    crumbs={[{ name: 'Contact' }]}
  />
  <section class="section">
    <div class="container split">
      <div class="panel reveal">
        <h2 class="h3">Request a free quote</h2>
        <QuoteForm />
      </div>
      <aside class="sticky" style="display:grid;gap:16px">
        <a class="card reveal" href={waLink('Hi Cercles, I would like a quotation.')} target="_blank" rel="noopener">
          <span class="card__icon"><Icon name="whatsapp" /></span>
          <h2 class="h3">WhatsApp</h2>
          <p>{SITE.phone}</p>
        </a>
        <a class="card reveal" style="--d:1" href={`tel:${SITE.phoneRaw}`}>
          <span class="card__icon"><Icon name="phone" /></span>
          <h2 class="h3">Call</h2>
          <p>{SITE.phone}</p>
        </a>
        <a class="card reveal" style="--d:2" href={`mailto:${SITE.email}`}>
          <span class="card__icon"><Icon name="mail" /></span>
          <h2 class="h3">Email</h2>
          <p>{SITE.email}</p>
        </a>
        <a class="card reveal" style="--d:3" href={SITE.instagram} target="_blank" rel="noopener me">
          <span class="card__icon"><Icon name="instagram" /></span>
          <h2 class="h3">Instagram</h2>
          <p>@cercles.in</p>
        </a>
        <div class="card reveal" style="--d:4">
          <span class="card__icon"><Icon name="pin" /></span>
          <h2 class="h3">Based in Kozhikode</h2>
          <p>Serving Kerala, Coimbatore and Bangalore.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
