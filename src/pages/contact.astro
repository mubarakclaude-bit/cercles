---
import Base from '../layouts/Base.astro';
import RingHero from '../components/RingHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { SITE, waLink } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const contactPage = {
  '@type': 'ContactPage',
  url: 'https://cercles.in/contact/',
  name: 'Contact Cercles',
  about: { '@id': 'https://cercles.in/#organization' },
};
const ways = [
  { icon: 'whatsapp', title: 'WhatsApp', text: SITE.phone, href: waLink('Hi Cercles, I would like a quotation.'), ext: true },
  { icon: 'phone', title: 'Call', text: SITE.phone, href: `tel:${SITE.phoneRaw}` },
  { icon: 'mail', title: 'Email', text: SITE.email, href: `mailto:${SITE.email}` },
  { icon: 'instagram', title: 'Instagram', text: '@cercles.in', href: SITE.instagram, ext: true },
];
---

<Base
  title="Contact Cercles, Kozhikode: Free Site Visit"
  description="Call or WhatsApp +91 75599 42708 or email cerclesindia@gmail.com for a free site visit and quotation in Kozhikode (Calicut) and across Kerala."
  path="/contact/"
  noFab
  schema={[contactPage, breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }])]}
>
  <RingHero
    compact
    eyebrow="Contact"
    title="Let's plan your project."
    lead="Tell us what you need. We visit your site in Kozhikode or anywhere in Kerala, understand the space and send one clear quotation."
    crumbs={[{ name: 'Contact' }]}
  >
    <div class="btn-row">
      <a class="btn" href="#details">Request a quote <Icon name="arrow" /></a>
      <a class="btn btn--line" href={`tel:${SITE.phoneRaw}`}>Call {SITE.phone}</a>
    </div>
  </RingHero>

  <section class="section" id="details">
    <div class="container split">
      <div class="panel reveal">
        <h2 class="h3">Request a free quote</h2>
        <QuoteForm />
      </div>
      <aside class="sticky" style="display:grid;gap:12px">
        {ways.map((w, i) => (
          <a class="card reveal" style={`--d:${i}`} href={w.href} target={w.ext ? '_blank' : undefined} rel={w.ext ? 'noopener' : undefined}>
            <span class="card__icon"><Icon name={w.icon} /></span>
            <h2 class="h3">{w.title}</h2>
            <p>{w.text}</p>
          </a>
        ))}
      </aside>
    </div>
  </section>
</Base>
