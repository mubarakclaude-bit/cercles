---
import Base from '../layouts/Base.astro';
import PartHero from '../components/PartHero.astro';
import Icon from '../components/Icon.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Faq from '../components/Faq.astro';
import { CATEGORIES, servicesIn } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const faqs = [
  { q: 'What is a Full-Circle project?', a: 'A Full-Circle project combines any of our 13 services under one plan, one quotation and one schedule, with a single project lead as your point of contact.' },
  { q: 'Is a Full-Circle project only for new homes?', a: 'No. It suits renovations, new homes and complete fit-outs. If a job needs more than one trade, it benefits from being planned together.' },
  { q: 'Can I start with one service and add more later?', a: 'Yes. You can start with a single service and extend the plan later, so nothing is wasted.' },
];
---

<Base
  title="Full-Circle Home Renovation in Kozhikode"
  description="Complete home renovation and fit-out in Kozhikode (Calicut): one plan, one quotation and one schedule across interiors, wiring, plumbing, roof and garden."
  path="/full-circle-projects/"
  schema={[faqSchema(faqs), breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Full-Circle Projects', path: '/full-circle-projects/' }])]}
>
  <PartHero
    pose={14}
    orbit
    eyebrow="Full-Circle Projects"
    title="One plan across every trade."
    lead="A complete home transformation in Kozhikode and across Kerala: interiors, exteriors, utilities and outdoors, delivered by one accountable team."
    crumbs={[{ name: 'Full-Circle Projects' }]}
  >
    <div class="btn-row"><a class="btn" href="/contact/">Plan my project <Icon name="arrow" /></a></div>
  </PartHero>

  <section class="section" id="details">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What you can combine</p>
        <h2 class="h2">Mix any of the 13 services.</h2>
      </div>
      <div class="grid grid--2">
        {CATEGORIES.map((c, i) => (
          <div class="panel reveal" style={`--d:${i % 2}`}>
            <h3 class="h3">{c.name}</h3>
            <p class="muted" style="font-size:0.9375rem">{c.blurb}</p>
            <ul class="checklist" style="margin-top:8px">
              {servicesIn(c.id).map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <HowWeWork />
  <Faq items={faqs} title="Full-Circle, explained." />
</Base>
