---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE, TRACKING, waLink } from '../data/site';
import { graph, organizationSchema, websiteSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Extra JSON-LD nodes for this page */
  schema?: unknown[];
  noindex?: boolean;
  ogImage?: string;
  /** Hide the floating WhatsApp button on pages that already have the form */
  noFab?: boolean;
}

const { title, description, schema = [], noindex: noindexProp = false, ogImage = '/og.png', noFab = false } = Astro.props;
// Test copies are never indexed by search engines.
const demo = import.meta.env.PUBLIC_DEMO === '1';
const noindex = noindexProp || demo;
const path = Astro.props.path ?? Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const ld = graph(organizationSchema(), websiteSchema(), ...schema);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-IN" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="IN-KL" />
    <meta name="geo.placename" content="Kozhikode, Kerala" />
    {SITE.geo && <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />}
    {SITE.geo && <meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />}
    {TRACKING.googleVerification && <meta name="google-site-verification" content={TRACKING.googleVerification} />}
    {TRACKING.bingVerification && <meta name="msvalidate.01" content={TRACKING.bingVerification} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cercles: Roof to Garden. One Call." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.url).href} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
    {
      // the GitHub test copy never sends visits, so the numbers only count the real site
      !demo && (TRACKING.ga4 || TRACKING.clarity) && (
        <script is:inline define:vars={{ ga: TRACKING.ga4, clarity: TRACKING.clarity }}>
          // Analytics load after the page has finished, so they never slow down the first view.
          (function () {
            function load() {
              if (ga) {
                window.dataLayer = window.dataLayer || [];
                window.gtag = function () {
                  window.dataLayer.push(arguments);
                };
                window.gtag('js', new Date());
                window.gtag('config', ga);
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga;
                document.head.appendChild(s);
              }
              if (clarity) {
                (function (c, l, a, r, i, t, y) {
                  c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
                  t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
                  y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
                })(window, document, 'clarity', 'script', clarity);
              }
            }
            if (document.readyState === 'complete') setTimeout(load, 1500);
            else addEventListener('load', function () { setTimeout(load, 1500); });
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {
      !noFab && (
        <a
          class="fab"
          href={waLink('Hi Cercles, I would like a quotation.')}
          target="_blank"
          rel="noopener"
          aria-label="Chat with Cercles on WhatsApp"
        >
          <Icon name="whatsapp" />
          <span>WhatsApp us</span>
        </a>
      )
    }
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
